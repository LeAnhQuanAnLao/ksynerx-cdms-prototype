# ==============================================================================
# CDMS Service Environment Configuration Template
# Copy this file to '.env' and populate with production secrets
# ==============================================================================

# Database Connection (PostgreSQL)
POSTGRES_USER=cdms_user
POSTGRES_PASSWORD=cdms_secure_password_replace_in_prod
POSTGRES_DB=cdms_db
DATABASE_URL=postgresql://cdms_user:cdms_secure_password_replace_in_prod@postgres:5432/cdms_db

# Vietful Mock Service URL
VIETFUL_API_BASE_URL=http://mock_vietful:8001
VIETFUL_REQUEST_TIMEOUT=5.0

# Polling & Circuit Breaker
SCHEDULER_INTERVAL_SECONDS=15
SCHEDULER_ENABLED=true
CIRCUIT_BREAKER_MAX_FAILURES=3
CIRCUIT_BREAKER_RESET_TIMEOUT=20

# Authentication & Security
REQUIRE_AUTH=false
API_KEY=cdms-secret-api-key-2026
WEBHOOK_SECRET=cdms-webhook-secret-2026

# Hardening & Rate Limiting
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=10
MAX_EXCEL_ROWS=10000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Service Metadata
DEBUG=false
PYTHONUNBUFFERED=1
